# ============================================
# AI PROVIDERS
# ============================================

# OpenAI - Required for GPT-4, DALL-E, and SEO generation
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude - Optional, for advanced marketing brain features
# Get API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini - Required for Gemini image generation and multimodal AI
# Get API key: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# Runway ML - Optional, for advanced video generation
# Get API key: https://runwayml.com/
RUNWAY_API_KEY=

# ============================================
# SOCIAL MEDIA PLATFORMS (for publishing)
# ============================================

# Meta (Facebook & Instagram)
# Create app: https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# TikTok Business API
# Apply: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API
# Setup: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# LinkedIn API
# Create app: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest API
# Setup: https://developers.pinterest.com/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ============================================
# ADVERTISING PLATFORMS
# ============================================

# Meta Ads (Facebook & Instagram Ads)
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# Google Ads API
# Setup: https://developers.google.com/google-ads/api/docs/start
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# TikTok Ads
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# ============================================
# MARKETING INTELLIGENCE & DATA
# ============================================

# SEMrush API - For SEO insights and competitor analysis
# Get API key: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=

# Google Trends API (optional, can use public scraping)
GOOGLE_TRENDS_API_KEY=

# SerpAPI - For search engine data and competitor tracking
# Get API key: https://serpapi.com/
SERPAPI_KEY=

# Social media scraping (optional - for competitor monitoring)
# Use services like Apify, Phantombuster, or ScraperAPI
APIFY_API_KEY=

# ============================================
# CALENDAR & SCHEDULING
# ============================================

# Google Calendar API
# Setup: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_API_KEY=

# ============================================
# VIDEO & SPOKESPERSON
# ============================================

# HeyGen - AI Spokesperson Videos
# Get API key: https://app.heygen.com/settings
HEYGEN_API_KEY=

# Synthesia - Alternative AI Video Platform
# Get API key: https://app.synthesia.io/
SYNTHESIA_API_KEY=

# ============================================
# CRM & COMMUNICATION
# ============================================

# Twilio - For SMS/WhatsApp lead nurture
# Get credentials: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid - For email marketing
# Get API key: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ============================================
# REPUTATION MONITORING
# ============================================

# Google My Business API
# Setup: https://developers.google.com/my-business
GOOGLE_MY_BUSINESS_API_KEY=

# Yelp Fusion API
# Get API key: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# ============================================
# ANALYTICS & ATTRIBUTION
# ============================================

# Google Analytics 4
# Setup: https://analytics.google.com/
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Shopify - For e-commerce ROI tracking
# Get credentials from your Shopify admin
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# ============================================
# APPLICATION SETTINGS
# ============================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Production Database Example (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/cohengpt"

# ============================================
# PAYMENT & SUBSCRIPTION
# ============================================

# Stripe - For payment processing and subscriptions
# Get API keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# ADMIN & SECURITY
# ============================================

# Admin password for superuser bypass (for testing)
# Usage: Add ?adminpw=admin123 to any URL to bypass all plan restrictions
ADMIN_PASSWORD=admin123

# ============================================
# OPTIONAL: CLOUD STORAGE
# ============================================

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================
# FEATURE FLAGS (set to 'true' to enable)
# ============================================

# Enable beta features
ENABLE_BETA_FEATURES=false

# Enable AI spokesperson (requires HeyGen or Synthesia)
ENABLE_AI_SPOKESPERSON=false

# Enable competitor scanning (requires scraping APIs)
ENABLE_COMPETITOR_SCANNER=false

# Enable ROI attribution (requires analytics integrations)
ENABLE_ROI_ATTRIBUTION=false
